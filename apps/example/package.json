{
  "name": "@better-apps/example",
  "private": true,
  "description": "A TanStack Start app that runs Better Apps features on SQLite, for trying features in a real app.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vp dev --host 127.0.0.1 --port 4190",
    "build": "vp build",
    "preview": "vp preview --host 127.0.0.1 --port 4191",
    "db:generate": "better-apps generate --output src/db/better-apps-schema.ts && drizzle-kit generate && vp fmt src/db/better-apps-schema.ts drizzle"
  },
  "dependencies": {
    "@better-apps/anchors": "workspace:*",
    "@better-apps/comments": "workspace:*",
    "@better-apps/database-drizzle": "workspace:*",
    "@better-apps/domains": "workspace:*",
    "@better-apps/identity-better-auth": "workspace:*",
    "@better-apps/mentions": "workspace:*",
    "@better-apps/react": "workspace:*",
    "@better-apps/reactions": "workspace:*",
    "@better-apps/tanstack-start": "workspace:*",
    "@buildkitgg/shadcn-alerts-manager": "0.1.0",
    "@buildkitgg/shadcn-baseui-kit": "npm:@buildkitgg/shadcn-baseui-nova@0.5.0",
    "@buildkitgg/shadcn-modals-manager": "1.1.3",
    "@buildkitgg/shadcn-theme": "0.2.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-table": "^8.21.3",
    "better-apps": "workspace:*",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@better-apps/cli": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "0.31.11",
    "oxc-transform-react": "0.156.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
