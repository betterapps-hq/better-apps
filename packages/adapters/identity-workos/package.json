{
  "name": "@better-apps/identity-workos",
  "version": "0.0.0",
  "private": true,
  "description": "The WorkOS identity adapter for Better Apps.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage"
  },
  "dependencies": {
    "better-apps": "workspace:*"
  },
  "peerDependencies": {
    "@workos-inc/node": "^11.0.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "catalog:",
    "@workos-inc/node": "12.2.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betterapps-hq/better-apps.git",
    "directory": "packages/adapters/identity-workos"
  },
  "homepage": "https://github.com/betterapps-hq/better-apps/tree/main/packages/adapters/identity-workos#readme",
  "bugs": {
    "url": "https://github.com/betterapps-hq/better-apps/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "better-apps",
    "workos",
    "identity",
    "auth"
  ]
}
