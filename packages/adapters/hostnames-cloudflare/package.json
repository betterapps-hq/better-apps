{
  "name": "@better-apps/hostnames-cloudflare",
  "version": "0.0.0",
  "private": true,
  "description": "The Cloudflare for SaaS hostnames adapter for Better Apps domains.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage"
  },
  "peerDependencies": {
    "@better-apps/domains": "workspace:*",
    "cloudflare": "^7.0.0"
  },
  "devDependencies": {
    "@better-apps/domains": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "catalog:",
    "better-apps": "workspace:*",
    "cloudflare": "7.3.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betterapps-hq/better-apps.git",
    "directory": "packages/adapters/hostnames-cloudflare"
  },
  "homepage": "https://github.com/betterapps-hq/better-apps/tree/main/packages/adapters/hostnames-cloudflare#readme",
  "bugs": {
    "url": "https://github.com/betterapps-hq/better-apps/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "better-apps",
    "cloudflare",
    "cloudflare-for-saas",
    "custom-hostnames"
  ]
}
